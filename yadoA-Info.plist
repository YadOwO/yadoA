<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Yado Asset connects to a development server on your local network only in development builds.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Yado Asset uses the microphone to hear what you say for voice entry.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Yado Asset uses Apple speech recognition to turn what you say into text for recording income and expenses. Your audio is never sent to Yado servers.</string>
	<key>OSSAvatarAccessKeyID</key>
	<string>$(OSS_AVATAR_ACCESS_KEY_ID)</string>
	<key>OSSAvatarAccessKeySecret</key>
	<string>$(OSS_AVATAR_ACCESS_KEY_SECRET)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>PaperBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.yado.yadoA.backup</string>
			<key>UTTypeDescription</key>
			<string>Yado Asset Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>yadoabackup</string>
				</array>
				<key>public.mime-type</key>
				<string>application/json</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
