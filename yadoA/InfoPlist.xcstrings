    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Permission prompt for voice bookkeeping.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yado Asset uses Apple speech recognition to turn what you say into text for recording income and expenses. Your audio is never sent to Yado servers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "芽豆资产使用 Apple 语音识别把你说的话转成文字，用来记录收支；录音不会发送到芽豆的服务器。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local network permission prompt; only development builds connect to a local server.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yado Asset connects to a development server on your local network only in development builds."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "芽豆资产仅在开发调试版本中连接局域网内的开发服务器。"
