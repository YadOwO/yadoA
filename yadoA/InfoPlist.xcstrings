      "comment" : "Permission prompt for voice bookkeeping.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yado Asset uses the microphone to hear what you say for voice entry."
