          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音由 iPhone 系统转成文字，录音本身不会发给芽豆或模型供应商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
