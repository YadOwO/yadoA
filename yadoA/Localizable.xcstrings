    "account.trend.not_enough" : {
      "comment" : "资产趋势页数据不足一天、画不出走势时的说明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough records to draw a trend yet. Check back after a few days of bookkeeping."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有足够的记录画出走势，记几天账后再来看看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有足夠的紀錄畫出走勢，記幾天帳後再來看看。"
          }
        }
      }
    },
    "account.trend.footnote" : {
      "comment" : "资产趋势页底部的口径说明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trends are worked out day by day from each account's current balance and its records. Only active accounts are included. Each account counts from the day it was added, or from just before its earliest record if that is earlier. Credit cards and loans count toward liabilities as the amount owed. The mix and rankings use each account's current balance."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走势按每个账户的当前余额和流水逐日倒推，只算启用中的账户。每个账户从建立那天起计入，补记了更早的流水时从那笔流水之前算起。信用卡、负债按欠款计入负债。构成和排行按各账户当前余额计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走勢按每個帳戶的目前餘額和收支紀錄逐日倒推，只算啟用中的帳戶。每個帳戶從建立那天起計入，補記了更早的紀錄時從那筆紀錄之前算起。信用卡、負債按欠款計入負債。組成和排行按各帳戶目前餘額計算。"
          }
        }
      }
    },
    "account.list.more" : {
