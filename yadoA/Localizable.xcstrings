    "account.delete.warning.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All Yado apps share this one Yado account, so deleting it affects every Yado app and can't be undone. The account will be permanently deleted, and you won't be able to sign in with it in any Yado app. Data synced to the cloud from every Yado app will be permanently deleted. Any remaining AI points are forfeited immediately and can't be restored or reversed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "芽豆系列的所有 App 共用这一个芽豆账号，注销会影响全部芽豆 App，且无法撤销：账号会被永久删除，在所有芽豆 App 里都无法再用它登录；各芽豆 App 同步到云端的数据都会被永久删除；剩余的 AI 点数立即作废，不能恢复也不能撤回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "芽豆系列的所有 App 共用這一個芽豆帳號，刪除會影響全部芽豆 App，且無法還原：帳號會被永久刪除，在所有芽豆 App 裡都無法再用它登入；各芽豆 App 同步到雲端的資料都會被永久刪除；剩餘的 AI 點數立即作廢，不能恢復也不能撤回。"
          }
        }
      }
    },
