    "developer.checkIn.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dev environment only. The guide only appears while today's check-in bubble shows on Profile; to start over, reset the guide, then clear check-ins. Setting a streak replaces existing check-ins with consecutive days up to yesterday, so checking in today earns that gift. Points already granted are kept."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有 dev 环境可用。引导只在“我的”页出现今天的签到气泡时弹出：想从头体验，先重置引导，再清空签到。设置连签会清掉现有签到，补出截至昨天的连续签到，今天一签就得到对应礼包。已经发的点数不收回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有 dev 環境可用。引導只在“我的”頁出現今天的簽到氣泡時彈出：想從頭體驗，先重設引導，再清空簽到。設定連簽會清掉現有簽到，補出截至昨天的連續簽到，今天一簽就得到對應禮包。已經發的點數不收回。"
          }
        }
      }
    },
