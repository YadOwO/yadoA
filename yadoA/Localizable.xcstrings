    "privacy.agreement.links" : {
      "comment" : "同意卡上的协议说明，两个 Markdown 链接地址不能改（yadoa-legal://terms 和 yadoa-legal://privacy）",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please read the [Terms of Service](yadoa-legal://terms) and the [Privacy Policy](yadoa-legal://privacy). The app goes online only after you tap Agree. If you tap Disagree, you can still keep books offline, but sign-in, sync, AI and feedback are unavailable."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请阅读[《用户协议》](yadoa-legal://terms)和[《隐私政策》](yadoa-legal://privacy)。点「同意」后才会联网；点「不同意」也能离线记账，但登录、同步、AI 和反馈都不能用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請閱讀[《使用者條款》](yadoa-legal://terms)和[《隱私權政策》](yadoa-legal://privacy)。點「同意」後才會連網；點「不同意」也能離線記帳，但登入、同步、AI 和意見回饋都不能用。"
          }
        }
      }
    },
