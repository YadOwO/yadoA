    "dataLink.consent.notRead.body" : {
      "comment" : "授权弹层第二段正文",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item names, photos, categories, notes and any other details are never read. The valuation is kept only on this device — it isn’t added to your ledger, exports, backups or cloud sync, and it isn’t sent to AI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会读取物品的名称、照片、分类、备注等任何明细。估值只保存在这台设备上，不会进入账本、导出、备份或云端同步，也不会发给 AI。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會讀取物品的名稱、照片、分類、備註等任何明細。估值只保存在這台裝置上，不會進入帳本、匯出、備份或雲端同步，也不會傳給 AI。"
          }
        }
      }
    },
