    "shortcut.screenshot.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record from Screenshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用截图记账"
          }
        }
      }
    },
    "shortcut.screenshot.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Yado Asset with an image to enter a transaction manually. Use Take Screenshot before this action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收截图并打开芽豆资产手动记账。请在此动作前添加“截屏”。"
          }
        }
      }
    },
    "shortcut.screenshot.input": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图"
          }
        }
      }
    },
    "shortcut.screenshot.summary ${screenshot}": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record from ${screenshot}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用${screenshot}记账"
          }
        }
