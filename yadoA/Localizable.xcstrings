    "privacy.agreement.decline.alert.message" : {
      "comment" : "点「不同意」后确认弹窗的说明：只能用基础的本地记账，哪些功能不能用，以及之后在哪里重新同意",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without agreeing, Yado Assets can only offer basic offline bookkeeping. Entries, accounts and charts still work and stay on this phone, but sign-in, cloud sync, AI bookkeeping and feedback are unavailable.\n\nYou can review and agree any time from the Profile tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不同意的话，芽豆资产只能提供基础的离线记账服务：记账、账户和图表照常可用，数据只存在这台手机上；登录、云同步、AI 记账和意见反馈都不能用。\n\n之后可以随时在「我的」页查看并同意。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不同意的話，芽豆資產只能提供基本的離線記帳服務：記帳、帳戶和圖表照常可用，資料只存在這支手機上；登入、雲端同步、AI 記帳和意見回饋都不能用。\n\n之後可以隨時在「我的」頁查看並同意。"
          }
        }
      }
    },
