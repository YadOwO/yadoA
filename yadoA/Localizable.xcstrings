    "profile.reset.scope.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud sync is on. \"This device only\" keeps your cloud data and turns off sync. \"This device and cloud\" deletes your cloud data too.\n\nChanged your mind? You can undo this here within %1$lld days."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已开启云端同步。「仅清除本机」会保留云端数据并关闭同步；「清除本机和云端」会同时删除云端数据。\n\n如果后悔了，%1$lld 天内可以在这里撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已開啟雲端同步。「僅清除本機」會保留雲端資料並關閉同步；「清除本機和雲端」會同時刪除雲端資料。\n\n如果後悔了，%1$lld 天內可以在這裡還原。"
          }
        }
      }
    },
    "profile.reset.scope.offlineMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud sync is on, but the app is in offline mode, so only this device can be erased. Your cloud data is kept and sync is turned off.\n\nChanged your mind? You can undo this here within %1$lld days."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已开启云端同步，但当前处于离线模式，只能清除本机：云端数据会保留，同步随之关闭。\n\n如果后悔了，%1$lld 天内可以在这里撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已開啟雲端同步，但目前處於離線模式，只能清除本機：雲端資料會保留，同步隨之關閉。\n\n如果後悔了，%1$lld 天內可以在這裡還原。"
          }
        }
      }
    },
