    },
    "ai.consent.purpose.title" : {
      "comment" : "“AI 记账说明”第四段小标题：用途和保存时间",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purpose and Retention"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用途和保存时间"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用途和保存時間"
          }
        }
      }
    },
    "ai.consent.purpose.body" : {
      "comment" : "“AI 记账说明”第四段正文：用途、服务端和本机保存时间，与隐私政策一致",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This content is used only to complete this one bookkeeping request or lookup. After processing, the Yado Asset servers do not keep your text, images, or AI replies; only the points deduction record is kept. Your chat history stays on this device and is deleted automatically after 90 days. If you turn on “Help Improve AI”, data is kept as described for that switch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些内容只用于完成这一次记账或查询。芽豆的服务器处理完不保存你的文字、图片和 AI 的回复，只保存扣点记录；对话记录只保存在本机，90 天后自动删除。打开“帮助改进 AI”时另按该开关的说明保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些內容只用於完成這一次記帳或查詢。芽豆的伺服器處理完不保存你的文字、圖片和 AI 的回覆，只保存扣點紀錄；對話紀錄只保存在本機，90 天後自動刪除。開啟“幫助改進 AI”時另按該開關的說明保存。"
          }
        }
      }
    },
    "ai.consent.purpose.bodyWithoutTrace" : {
      "comment" : "“AI 记账说明”第四段正文，用于不提供“帮助改进 AI”的环境（线上包）",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This content is used only to complete this one bookkeeping request or lookup. After processing, the Yado Asset servers do not keep your text, images, or AI replies; only the points deduction record is kept. Your chat history stays on this device and is deleted automatically after 90 days."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些内容只用于完成这一次记账或查询。芽豆的服务器处理完不保存你的文字、图片和 AI 的回复，只保存扣点记录；对话记录只保存在本机，90 天后自动删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些內容只用於完成這一次記帳或查詢。芽豆的伺服器處理完不保存你的文字、圖片和 AI 的回覆，只保存扣點紀錄；對話紀錄只保存在本機，90 天後自動刪除。"
          }
        }
      }
    },
