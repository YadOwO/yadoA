    "account.balance_adjustment.target_explanation.debt" : {
      "comment" : "信用卡、负债账户调整余额时的说明：欠款填正数，不要加负号",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the total you owe as a positive number, without a minus sign. Debt is subtracted from net worth automatically. Choose Overpaid only if you paid back more than you owed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填欠款总额，正数就行，不用加负号；负债会自动从净资产里扣掉。只有多还了钱（溢缴）时才选「多还的钱」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填欠款總額，正數就行，不用加負號；負債會自動從淨資產裡扣掉。只有多還了錢（溢繳）時才選「多還的錢」。"
          }
        }
      }
    },
