    "dataLink.intro" : {
      "comment" : "数据联动页顶部的说明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once authorized, Yado Assets can read the total purchase price of your items in yado Items, turn it into a valuation, and show it in Accounts and net worth. You can revoke this at any time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授权后，芽豆资产可以读取你在芽豆有物里的物品购入价合计，折算成估值放进账户页和净资产。随时可以取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授權後，芽豆資產可以讀取你在芽豆有物裡的物品購入價合計，折算成估值放進帳戶頁和淨資產。隨時可以取消。"
          }
        }
      }
    },
    "dataLink.unavailable" : {
      "comment" : "数据联动页：没登录、离线或服务端没打开联动时的说明",
