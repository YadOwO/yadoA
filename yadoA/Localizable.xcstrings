    "feedback.diagnostics.footnote" : {
      "comment" : "附带诊断开关下方的说明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes up to 5 recent crash, hang, or disk-write reports from this device: call stacks, iOS version, and app version. No ledger data. Sent only with this message when turned on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含本机最近最多 5 份崩溃、卡顿或磁盘写入异常报告：调用栈、系统版本和 App 版本，不含任何账本数据。只在打开后随这条反馈发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含本機最近最多 5 份當機、卡頓或磁碟寫入異常報告：呼叫堆疊、系統版本和 App 版本，不含任何帳本資料。只在開啟後隨這則意見回饋傳送。"
          }
        }
      }
    },
