        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 AI 記帳前，請先了解哪些內容會傳出去。"
          }
        }
      }
    },
    "ai.consent.data.title" : {
      "comment" : "“AI 记账说明”第一段小标题：发送哪些内容",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What Gets Sent"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会发送哪些内容"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會傳送哪些內容"
          }
        }
      }
    },
    "ai.consent.data.body" : {
      "comment" : "“AI 记账说明”第一段正文：发送的内容",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text from what you say, anything you type, and any images you send, plus the account names, categories, and related transactions that help AI pick the right account and category."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你说的话转成的文字、打的字、发的图片，以及为了让 AI 选对账户和分类而附带的账户名、分类和相关收支明细。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你說的話轉成的文字、打的字、傳的圖片，以及為了讓 AI 選對帳戶和分類而附帶的帳戶名稱、分類和相關收支明細。"
          }
        }
      }
    },
    "ai.consent.recipient.title" : {
      "comment" : "“AI 记账说明”第二段小标题：发给谁",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who Receives It"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发给谁"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳給誰"
          }
        }
      }
    },
    "ai.consent.recipient.body" : {
      "comment" : "“AI 记账说明”第二段正文：接收方，不写具体供应商",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This content goes to the Yado Asset servers first, which then pass it to a third-party model provider for processing. Your account identifier is not sent to the model provider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些内容先发到芽豆的服务器，再由服务器转给第三方模型供应商处理。不会把你的账号标识发给模型供应商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些內容先傳到芽豆的伺服器，再由伺服器轉給第三方模型供應商處理。不會把你的帳號識別資訊傳給模型供應商。"
          }
        }
      }
    },
    "ai.consent.speech.title" : {
      "comment" : "“AI 记账说明”第三段小标题：语音",
      "extractionState" : "manual",
