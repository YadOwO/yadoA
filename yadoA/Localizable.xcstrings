    "account.analysis.debt_ratio.formula" : {
      "comment" : "资产负债率卡片底部的算法说明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debt-to-asset ratio = debts ÷ assets"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "资产负债率 = 负债 ÷ 资产"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資產負債率 = 負債 ÷ 資產"
          }
        }
      }
    },
    "account.analysis.debt_ratio.none" : {
