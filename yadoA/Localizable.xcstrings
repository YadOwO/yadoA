    "onboarding.sync.message" : {
      "comment" : "首次引导同步询问的说明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your ledger is uploaded to Yado's servers over an encrypted connection, so it's there on a new phone or any of your devices. It's used only for sync. Leave it off and it stays only on this phone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，账本会经加密连接上传到芽豆的服务器，换手机、多台设备都能看到；只用于同步，不做别的用途。不开启，账本就只存在本机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，帳本會經加密連線上傳到芽豆的伺服器，換手機、多台裝置都能看到；只用於同步，不做別的用途。不開啟，帳本就只存在本機。"
          }
        }
      }
