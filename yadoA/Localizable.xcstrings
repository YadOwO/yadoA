{
  "sourceLanguage" : "en",
  "strings" : {
    "feedback.title" : {
      "comment" : "「我的」页意见反馈入口与反馈页标题",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意见反馈"
          }
        }
      }
    },
    "feedback.row.unread" : {
      "comment" : "「我的」页意见反馈行尾的未读回复数，%@ 为条数",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ new"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 条新回复"
          }
        }
      }
    },
    "feedback.signIn.message" : {
      "comment" : "未登录点意见反馈时登录页与反馈页上的说明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to send us feedback. Your conversation stays with your account, so you can see our replies on any device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录后就能给我们发反馈。对话跟着账号走，换了手机也能看到回复。"
          }
        }
      }
    },
    "feedback.welcome" : {
      "comment" : "反馈对话开头的欢迎语，只在本机显示",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi! Found a problem or have an idea? Tell us here. We read every message and will reply as soon as we can."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好！遇到问题或有什么建议，直接发在这里。每一条我们都会看，并尽快回复你。"
          }
        }
      }
    },
    "feedback.input.placeholder" : {
      "comment" : "反馈页输入框占位文字",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe the problem or idea"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说说遇到的问题或建议"
          }
        }
      }
    },
    "feedback.input.overflow" : {
      "comment" : "反馈正文超出字数上限时的提示，%@ 为超出的字数",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ characters over the limit"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超出 %@ 字"
          }
        }
      }
    },
